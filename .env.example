# ==============================================================================
# GeoBrief 3D - 환경 변수 설정 템플릿 (.env.example)
# Vercel 배포 시 Settings > Environment Variables 에 등록하세요.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. [필수] V-World 오픈플랫폼 2.0 API 인증키
# 국토교통부 브이월드 건축물/지적도 실시간 데이터 연동에 사용됩니다.
# 미등록 시에도 무료 오픈 벡터 타일(OpenFreeMap)로 자동 폴백됩니다.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_VWORLD_API_KEY=your_vworld_api_key_here

# ------------------------------------------------------------------------------
# 2. [선택] Supabase 클라우드 데이터 저장소 (1인 실무 단독 사용 환경)
# 분석 부지, 3D 매스 프리셋, 북마크 시점 및 보고서 프로젝트를 클라우드에 영구 저장합니다.
# 미등록 시 브라우저 LocalStorage로 100% 자동 폴백되어 정상 작동합니다.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ------------------------------------------------------------------------------
# 3. [공공데이터포털] 국토교통부 건물통합정보 / 건축물대장 API 인증키 (data.go.kr)
# 건축물 실제 층수(GRND_FLR_CNT), 실측 높이(HEI), 건물명, 주용도코드 정밀 융합에 사용됩니다.
# 미등록 시 V-World WFS + OSM 속성으로 100% 무중단 자동 폴백됩니다.
DATA_GO_KR_API_KEY=your_public_data_portal_key_here

# 4. [옵션] 기타 부가 외부 API 키
# ------------------------------------------------------------------------------
NEXT_PUBLIC_KAKAO_REST_API_KEY=your_kakao_rest_api_key_here
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=your_kakao_js_key_here
OPENAI_API_KEY=your_openai_api_key_here
